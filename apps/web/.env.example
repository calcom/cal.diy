# Node / Docker. Copy to .env (in apps/web for `yarn dev`, or the repo root for docker compose).

# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The public URL people use to reach this instance; used for OAuth redirects and CSRF checks.
BETTER_AUTH_URL=http://localhost:3000

# Behind a reverse proxy, the proxies whose X-Forwarded-For to believe, so sign-in rate limits see
# real client IPs: "loopback" for one on the same host, or a comma-separated list of addresses.
# Leave empty when clients connect directly.
TRUST_PROXY=

# Webhooks to this server's own network (localhost, private and link-local addresses, names without
# a dot such as Docker service names) are refused, so users can't reach internal services through
# them. Set to true if you post webhooks to something on the same machine or network, like n8n.
ALLOW_PRIVATE_WEBHOOK_URLS=

# SQLite file (or a libsql:// URL with DATABASE_AUTH_TOKEN).
DATABASE_URL=file:./data/cal.db

# Encrypts calendar credentials at rest (same variable and format as Cal). 32 characters:
#   openssl rand -base64 24
CALENDSO_ENCRYPTION_KEY=

# Optional: Google sign-in and Google Calendar/Meet, from one OAuth client.
# Authorized redirect URIs: <BETTER_AUTH_URL>/api/auth/callback/google
#                           <BETTER_AUTH_URL>/api/integrations/googlecalendar/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: single sign-on through your own OpenID Connect provider (Authentik, Keycloak, Authelia,
# Zitadel, Okta, ...). OIDC_ISSUER is the issuer URL; /.well-known/openid-configuration is added if
# missing. Redirect URI: <BETTER_AUTH_URL>/api/auth/callback/oidc. OIDC_NAME labels the button
# ("Continue with <OIDC_NAME>", default "SSO"). An existing account is signed into only when the
# provider marks the email as verified and the account's own email has been verified.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=

# Optional: booking emails (Cal's variable names). Either Resend over HTTP (works on Cloudflare too)...
EMAIL_FROM=
EMAIL_FROM_NAME=Cal.diy
RESEND_API_KEY=
# ...or SMTP (Node/Docker only; Workers can't open SMTP connections).
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=

# Optional apps. Each one shows as available under Apps once its variables are set. Redirect URIs
# follow Cal's paths: <BETTER_AUTH_URL>/api/integrations/<app>/callback. CalDAV, Apple Calendar,
# Jitsi and the room-link apps (Whereby, …) need nothing here beyond CALENDSO_ENCRYPTION_KEY.

# Outlook Calendar and Microsoft Teams share one Microsoft Entra app. Redirect URIs:
#   <BETTER_AUTH_URL>/api/integrations/office365calendar/callback
#   <BETTER_AUTH_URL>/api/integrations/office365video/callback
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# Zoom (an OAuth app in the Zoom marketplace). Redirect URI: .../api/integrations/zoomvideo/callback
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Cal Video: a Daily.co API key. Every host can use it without installing anything.
DAILY_API_KEY=

# The Jitsi server for Jitsi Meet rooms (Cal's default below).
JITSI_HOST=https://meet.jit.si/cal

# Stripe payments through Stripe Connect, as in Cal. Redirect URI: .../api/integrations/stripepayment/callback
# Add a Connect webhook (events on connected accounts) at
#   <BETTER_AUTH_URL>/api/integrations/stripepayment/webhook
# for checkout.session.completed and checkout.session.async_payment_succeeded.
STRIPE_PRIVATE_KEY=
STRIPE_CLIENT_ID=
STRIPE_WEBHOOK_SECRET=

# Development and tests only, ignored by production builds: these point providers at local fakes.
# GOOGLE_OAUTH_AUTHORIZE_URL, GOOGLE_OAUTH_TOKEN_URL, GOOGLE_OAUTH_REVOKE_URL, GOOGLE_CALENDAR_API_URL,
# MS_OAUTH_URL, MS_GRAPH_API_URL, ZOOM_OAUTH_URL, ZOOM_API_URL, DAILY_API_URL, APPLE_CALDAV_URL,
# STRIPE_API_URL, STRIPE_CONNECT_URL

# Browser push notifications for new bookings. Generate a pair with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact push services use for this sender (mailto: or https:); defaults to BETTER_AUTH_URL.
VAPID_SUBJECT=
