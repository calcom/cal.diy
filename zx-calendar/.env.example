# ── Access ────────────────────────────────────────────────────────────────
# Passcode Z uses to unlock the Executive view. Leave empty only for local dev.
EXECUTIVE_PASSCODE=
# Random string used to sign the session cookie (openssl rand -base64 32).
AUTH_SECRET=

# ── People on every booked call ───────────────────────────────────────────
Z_EMAIL=
XOE_EMAIL=

# ── Storage (Vercel → Storage → Upstash for Redis sets these automatically) ─
KV_REST_API_URL=
KV_REST_API_TOKEN=
# or: UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN

# ── Google Calendar (bookings land in this account's calendar) ───────────
# OAuth client (type "Web application"), redirect URI:
#   https://<your-domain>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: skip the in-app "Connect Google" flow by pasting a refresh token.
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ── Brain dump AI parsing ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
