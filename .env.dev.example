# Zkopíruj do .env.dev (je v .gitignore) a nahraď všechny CHANGE_ME.
# Doporučeno: hesla bez speciálních znaků, ať nemusíš kódovat DATABASE_URL:
#   openssl rand -hex 24
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
CALDIY_DB_PASSWORD=CHANGE_ME
AUTHENTIK_DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

# Po prvním startu se NESMÍ měnit (podepisuje sessions):  openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=CHANGE_ME

# Počáteční účet akadmin (platí jen při prvním startu)
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@calendiy.localhost
AUTHENTIK_BOOTSTRAP_PASSWORD=CHANGE_ME

# Volitelně: změna portů na localhostu, pokud kolidují s lokálními službami
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# MAILPIT_SMTP_HOST_PORT=1025
# MAILPIT_UI_HOST_PORT=8025
# AUTHENTIK_HOST_PORT=9000
